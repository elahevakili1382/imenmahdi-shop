PORT=3001
JWT_SECRET=imenmahdi-change-this
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
ADMIN_NOTIFY_PHONE=
VITE_API_URL=/api

# زرین‌پال — مطابق پنل پذیرنده
ZARINPAL_MERCHANT_ID=
# true = sandbox.zarinpal.com | false = payment.zarinpal.com
ZARINPAL_SANDBOX=true
# آدرس عمومی API برای callback_url (لوکال: http://127.0.0.1:3001)
API_PUBLIC_URL=http://127.0.0.1:3001
# آدرس فرانت بعد از بازگشت از درگاه
FRONTEND_URL=http://127.0.0.1:5173/imenmahdi-shop
# واحد مبلغ: IRT تومان (قیمت‌های فروشگاه) | IRR ریال
ZARINPAL_CURRENCY=IRT
